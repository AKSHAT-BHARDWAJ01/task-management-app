# Local development: leave DATABASE_URL unset to use SQLite at backend/data/tasks.db
# Production (Vercel API project): set these in Project Settings → Environment Variables.
#
# DATABASE_URL
#   Supabase PostgreSQL URI. URL-encode special characters in the password
#   (example: @ -> %40, # -> %23, / -> %2F).
#   Prefer the Transaction pooler URI (port 6543) for serverless.
#   Example shape (do not commit real credentials):
#   postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# JWT_SECRET_KEY
#   Long random secret used to sign access tokens.
#
# ACCESS_TOKEN_EXPIRE_MINUTES
#   Optional. Defaults to 60.
#
# CORS_ORIGINS
#   Comma-separated allowed browser origins. Must include the Vercel frontend URL.
#   Example:
#   https://task-manager-frontend-self-chi.vercel.app,http://localhost:5173

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://task-manager-frontend-self-chi.vercel.app
