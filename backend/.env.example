# Local development: leave DATABASE_URL unset to use SQLite at backend/data/tasks.db
# Production (Vercel API project): set these in Project Settings → Environment Variables.
#
# DATABASE_URL
#   Supabase PostgreSQL URI. URL-encode special characters in the password
#   (example: @ -> %40, # -> %23, / -> %2F).
#   Prefer the Transaction pooler URI (port 6543) for serverless.
#   Example shape (do not commit real credentials):
#   postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# JWT_SECRET_KEY
#   Long random secret used to sign access tokens.
#
# ACCESS_TOKEN_EXPIRE_MINUTES
#   Optional. Defaults to 60.
#
# CORS_ORIGINS
#   Comma-separated allowed browser origins. Must include the Vercel frontend URL.
#   Example:
#   https://task-manager-frontend-self-chi.vercel.app,http://localhost:5173
#
# CRON_SECRET
#   Required for /api/internal/jobs/tick (reminders, digest, push delivery).
#   Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
#   Store the same value as the CRON_SECRET secret in GitHub Actions, together
#   with TASKFLOW_API_URL (the API origin, without /api).
#
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
#   Web push. Generate a key pair once with:
#     backend/.venv/bin/vapid --gen && backend/.venv/bin/vapid --applicationServerKey
#   The private key stays on the server only. VAPID_SUBJECT is mailto: or https: contact.
#
# EXPO_ACCESS_TOKEN
#   Optional. Only needed if "enhanced push security" is turned on in the Expo project.

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://task-manager-frontend-self-chi.vercel.app
