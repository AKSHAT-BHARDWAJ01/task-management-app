# Local development: leave DATABASE_URL unset to use SQLite at backend/data/tasks.db
# Production: set DATABASE_URL to your Supabase PostgreSQL connection string.
# URL-encode special characters in the password (e.g. @ becomes %40).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
