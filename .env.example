# Root-level example for Docker / local tooling.
# Backend runtime reads backend/.env (see backend/.env.example).
#
# Frontend (Vercel frontend project) build-time variable:
# VITE_API_BASE_URL=https://task-manager-api-coral-five.vercel.app/api

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://task-manager-frontend-self-chi.vercel.app
