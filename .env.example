# Local development: leave DATABASE_URL unset in backend/.env to use SQLite.
# Production: set DATABASE_URL to your Supabase PostgreSQL connection string.
# URL-encode special characters in the password (e.g. @ becomes %40).
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
